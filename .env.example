# Copy to .env.local and fill in. NEVER commit .env.local. Names only here, no real values.
# --- Core ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
APP_MODE=demo                      # real | demo
# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:54329/icpilot_test
# --- Neo4j ---
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
# --- LLM ---
LLM_PROVIDER=google
LLM_MODEL=
EMBED_MODEL=
EMBED_DIM=768
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
# --- Search ---
TAVILY_API_KEY=
SERPER_API_KEY=
# --- Enrichment (optional; missing = not_configured) ---
HUNTER_API_KEY=
APOLLO_API_KEY=
CLEARBIT_API_KEY=
PROSPEO_API_KEY=
# --- Messaging ---
DISPATCH_MODE=dry_run              # dry_run | sandbox | live  (keep dry_run)
EMAIL_PROVIDER=smtp                # smtp | gmail | sendgrid
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
SANDBOX_ALLOWED_RECIPIENTS=
SENDER_PHYSICAL_ADDRESS=
UNSUBSCRIBE_SECRET=
# --- Cron / webhooks ---
CRON_SECRET=
WEBHOOK_SECRET=
# --- Flexprice (bonus) ---
FLEXPRICE_API_KEY=
FLEXPRICE_BASE_URL=
# --- Band (bonus) ---
BAND_API_KEY=
BAND_WORKSPACE_ID=
# --- Demo account ---
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
